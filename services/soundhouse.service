[Unit]
Description=Soundhouse Fastify API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=soundhouse
WorkingDirectory=/var/www/soundhouse/server
EnvironmentFile=/var/www/soundhouse/server/.env
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/soundhouse/media

[Install]
WantedBy=multi-user.target
