# postgres connection
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus

# api port
PORT=3000

# where the vite frontend runs (for cors)
FRONTEND_ORIGIN=http://localhost:5173

# random long string for signing session cookies
COOKIE_SECRET=replace-with-a-long-random-string

# first admin, created automatically on first migrate
ADMIN_USER=admin
ADMIN_PASS=change-this-password

# set to production when deploying (enables secure cookies)
NODE_ENV=development
